# Server
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=casino_user
DB_PASSWORD=casino_pass
DB_NAME=casino
DB_SSLMODE=disable

# JWT
# REQUIRED: JWT_SECRET has no default. It must be at least 32 bytes long and
# the server refuses to start with a missing or short secret.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRY=15
JWT_REFRESH_EXPIRY=10080

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
# Trusted proxy header used to derive the client IP for rate limiting.
# Empty means X-Forwarded-For / Forwarded are IGNORED (anti-spoofing default).
RATE_LIMIT_TRUSTED_HEADER=

# Security headers
HSTS_ENABLED=true

# Mailer
# MAILER_DRIVER=console logs verification links; "smtp" sends real email.
MAILER_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
VERIFY_BASE_URL=http://localhost:8080
# How long an issued email verification token stays valid (minutes).
EMAIL_VERIFY_TTL_MIN=1440

# KYC document storage
# Directory where uploaded KYC documents are stored (design D1). Files are
# written under generated keys (UUID + sanitized extension), never under the
# user-supplied filename.
KYC_STORAGE_DIR=./data/kyc
